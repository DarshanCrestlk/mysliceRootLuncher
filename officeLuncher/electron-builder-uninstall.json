{
  "extends": null,
  "appId": "com.myslice.uninstaller",
  "productName": "MySlice Uninstall",
  "npmRebuild": false,
  "forceCodeSigning": false,
  "directories": {
    "output": "dist-uninstall"
  },
  "files": [
    "uninstall.js",
    "cleanup.js"
  ],
  "extraMetadata": {
    "main": "uninstall.js"
  },
  "win": {
    "target": "nsis",
    "icon": "myslice.png",
    "requestedExecutionLevel": "requireAdministrator",
    "signAndEditExecutable": false
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "allowElevation": true,
    "runAfterFinish": true,
    "createDesktopShortcut": false,
    "createStartMenuShortcut": false,
    "artifactName": "MySlice Uninstall ${version}.exe",
    "uninstallDisplayName": "MySlice Uninstall"
  }
}

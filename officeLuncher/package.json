{
  "name": "officelauncher",
  "version": "1.0.0",
  "description": "MySlice LTS installer",
  "author": "Your Name or Company",
  "scripts": {
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File ./install.ps1 -ExePath ../mysliceLauncher/dist/win-unpacked/mysliceLTS.exe -ManifestSource ./manifest.xml -LauncherSource ../mysliceLauncher/dist/win-unpacked",
    "start:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File ./uninstall.ps1",
    "dist": "node ./build-installer.js"
  },
  "build": {
    "appId": "com.yourcompany.myslice.installer",
    "productName": "MySlice",
    "executableName": "mysliceLTS",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "electronVersion": "31.3.1",
    "forceCodeSigning": false,
    "npmRebuild": false,
    "compression": "maximum",
    "defaultArch": "x64",
    "icon": "icon.ico",
    "win": {
      "target": "nsis",
      "icon": "icon.ico",
      "requestedExecutionLevel": "requireAdministrator",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": true,
      "allowElevation": true,
      "runAfterFinish": false,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": false,
      "include": "installer.nsh",
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico",
      "artifactName": "MySlice Setup ${version}.exe",
      "uninstallDisplayName": "MySlice"
    }
  },
  "devDependencies": {
    "electron-builder": "^26.0.12"
  }
}

{
  "name": "myslice-launcher",
  "version": "1.0.0",
  "description": "Hidden protocol handler for mysliceLTS://",
  "main": "main.js",
  "author": "Your Name",
  "license": "MIT",

  "scripts": {
    "start": "electron .",
    "build": "node ../scripts/ensure-icon.js && electron-builder --dir"
  },

  "devDependencies": {
    "electron": "^31.3.1",
    "electron-builder": "^25.0.5"
  },

  "build": {
    "appId": "com.mysliceLTS.launcher",
    "productName": "mysliceLTS",
    "electronLanguages": ["en-US"],
    "directories": {
      "buildResources": "build"
    },

    "win": {
      "target": "dir",
      "icon": "icon.ico"
    },
    "extraResources": [
      {
        "from": "myslice.ps1",
        "to": "myslice.ps1"
      }
    ],

    "files": [
      "main.js"
    ]
  }
}
